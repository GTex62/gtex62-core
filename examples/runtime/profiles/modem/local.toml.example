profile_id = "local"
enabled = true
# Signal stats and event-log entries change slowly outside an active
# incident — cadence should stay much lower than the WAN loss-based
# provider (60-120s). A few minutes is plenty.
cache_ttl_sec = 300

[connection]
# CM1000 admin UI, reached through pfSense's NAT-to-VIP path — see
# docs/network-providers-roadmap.md, "Modem-Level Corroboration Provider".
base_url = "http://192.168.100.1"
username = "admin"
# timeout_sec = 8

[credentials]
# Real value goes only in the runtime copy of this file
# (~/.config/gtex62-core/profiles/modem/local.toml) — never committed here.
# chmod 600 that file once the real password is in it; fetch_modem.py warns
# (but does not block) if it's readable beyond the owner.
# "CHANGE_ME" is a deliberate placeholder, not a working default — a fresh
# bootstrap should fail loudly (state=error, clear note) rather than "run"
# and silently never authenticate.
password = "CHANGE_ME"

[eventlog]
# Trailing window recent_t3_timeouts is summed over.
window_minutes = 60
# FALLBACK ONLY, in seconds. fetch_modem.py normally self-calibrates this
# every poll by reading DocsisStatus.asp's own #Current_systemtime field
# and comparing it to host time (resolve_clock_offset_sec()) — that live
# measurement is used whenever it's available and sane, and this
# configured value is only consulted if it isn't (field missing, or
# implying something wild like a modem whose clock hasn't synced since a
# reboot). You should NOT need to hand-tune this for normal operation,
# and it does NOT need revisiting across DST transitions the way it did
# before self-calibration existed.
#
# Discovered 2026-09-07 (see docs/network-providers-roadmap.md's Sept 6/7
# and Sept 7 session logs): this deployment's CM1000 clock was found
# running ~60 minutes behind host time (modem stuck on Standard Time
# while the host observes DST is the leading theory) — that's what this
# value reflects, as a reasonable best-effort fallback for the rare case
# self-calibration can't run. Set to 0 for a fresh deployment unless
# you've independently confirmed your own modem is skewed the same way.
clock_offset_sec = 3600
