# Off by default: nothing reads this file unless `[providers] airgradient = true` is set in core.toml
# AND the launching suite binds and lists the domain (see suites/<id>.toml.example). Most installs
# do not own an AirGradient, so it is not wired in unless you do it.
profile_id = "indoor"
enabled = true
# Short text shown after INDOOR in the ENV panel header and on the SRC line
# (uppercase, 8 characters at most). Leave empty for plain "INDOOR".
# label = "CAVE"
# Poll cadence for the launcher's refresh loop (seconds); 30 to 60 is plenty.
cache_ttl_sec = 30

[device]
# Address of the AirGradient ONE on your network (local API, no cloud). Required.
host = ""
timeout_sec = 5
# How long a field the device omitted from a response (firmware 3.7.0 drops temperature,
# humidity and compensated PM2.5 together about a fifth of the time) is carried forward.
carry_max_age_sec = 600

[advisor]
enabled = true
# Compute and log verdicts but never show an alert in any suite. Leave on for the first
# week, then set false. See docs/airgradient-provider-design.md, Rollout.
shadow = true
# One row per minute of every advisor input under runtime/airgradient/<profile>/, for replays.
log_inputs = true
log_keep_days = 365
# A hole in the record longer than this many seconds is marked in verdict_log.txt ("gap" lines): either
# "offline" (the machine was off or the suite closed) or "unreachable" (the device could not be read).
# gap_log_sec = 300

# Every advisor threshold can be overridden here; names and defaults are the DEFAULTS
# dictionary in providers/airgradient/ventilation_advisor.py (docs/ventilation-advisor-design.md).
# [advisor.thresholds]
# co2_enter = 1000
# voc_need = 250

[advisor.pollen]
enabled = true
# csv = ""   # default: $GTEX62_SHARED_ASSETS/data/pollen/pollen_mem_v2.csv
threshold = 80
categories = ["tree", "grass"]

[advisor.outdoor]
# The air and weather profiles are taken from the launching suite's bindings.
air_max_age_sec = 7200
wx_max_age_sec = 1800

# Optional, off unless this section exists: archive Home Assistant's history for the sensors, keeping a
# rolling window (Home Assistant keeps raw history only 10 days and keeps running while this machine is
# off). Runs from a systemd user timer; see scripts/airgradient-ha-export.py and
# systemd/user/gtex62-airgradient-ha-export.timer (copy both units to ~/.config/systemd/user, then
# `systemctl --user enable --now gtex62-airgradient-ha-export.timer`).
# [ha_export]
# ha_db = "~/.local/ha-config/home-assistant_v2.db"   # HA's recorder database (read-only, via a private copy)
# prefix = "sensor.<your_device>_"                      # entity id prefix of the AirGradient sensors (required)
# thermostat = "climate.<your_thermostat>"              # optional: setpoint and AC state
# weather = "weather.<your_weather_entity>"             # optional: HA's outdoor weather entity
# keep_months = 12                                      # months kept live; older rows go to archive/ as monthly .csv.gz
