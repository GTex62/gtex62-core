profile_id = "local"
enabled = true
# Signal stats and event-log entries change slowly outside an active
# incident — cadence should stay much lower than the WAN loss-based
# provider (60-120s). A few minutes is plenty.
cache_ttl_sec = 300

[connection]
# CM1000 admin UI, reached through pfSense's NAT-to-VIP path — see
# docs/network-providers-roadmap.md, "Modem-Level Corroboration Provider".
base_url = "http://192.168.100.1"
username = "admin"
# timeout_sec = 8

[credentials]
# Real value goes only in the runtime copy of this file
# (~/.config/gtex62-core/profiles/modem/local.toml) — never committed here.
# chmod 600 that file once the real password is in it; fetch_modem.py warns
# (but does not block) if it's readable beyond the owner.
# "CHANGE_ME" is a deliberate placeholder, not a working default — a fresh
# bootstrap should fail loudly (state=error, clear note) rather than "run"
# and silently never authenticate.
password = "CHANGE_ME"

[eventlog]
# Trailing window recent_t3_timeouts is summed over.
window_minutes = 60
# Correction added to every modem-reported event timestamp before it's
# compared to host time, in seconds. Default 0 (no correction) — only set
# this if you've confirmed your own modem's clock is actually skewed;
# don't copy 3600 blindly onto a different modem/deployment.
#
# Discovered 2026-09-07 (see docs/network-providers-roadmap.md's Sept 7
# session log): this deployment's CM1000 was found to be consistently
# ~63-67 minutes *behind* host time during a live, actively-flapping T3
# burst (new rows landing seconds apart in modem-time across three
# independent measurements — not staleness, a real clock offset). Leading
# theory: the modem's clock doesn't observe DST and stays on Standard
# Time (CST, UTC-6) while the host correctly runs CDT (UTC-5) — a clean
# one-hour gap. Set to 3600 for this deployment while DST is in effect.
# **Revisit when DST ends (~Nov 2026)**: if the theory holds, the offset
# should drop to ~0 once the host reverts to CST and both clocks agree
# again — leaving this at 3600 past that point would reintroduce the
# opposite failure (events counted as more recent than they really are).
clock_offset_sec = 3600
