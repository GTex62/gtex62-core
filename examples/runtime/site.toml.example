site_id = "local"

[location.home]
name = "home"
lat = 41.8781
lon = -87.6298
timezone = "America/Chicago"

[credentials]
openweather_api_key = "YOUR_OPENWEATHER_API_KEY"
airnow_api_key = "YOUR_AIRNOW_API_KEY"

[network]
primary_interface = "eno1"

[vlan]
labels = ["HOME", "IOT", "GUEST", "INFRA", "CAM"]
hosts = ["192.168.10.1", "192.168.20.1", "192.168.30.1", "192.168.40.1", "192.168.50.1"]

[speedtest]
baseline_down_mbps = 500
fallback_down_mbps = 500
server_id = ""

[aviation]
primary = "KMEM"
metar = "KMEM"
taf = "KMEM"
station_model = "KMEM"
advisories_center = "KMEM"

[calendar]
timezone = "America/Chicago"

[pfsense]
ssh_target = "pf"

[pfsense.interfaces]
wan = "igc0"
home = "igc1.10"
iot = "igc1.20"
guest = "igc1.30"
infra = "igc1.40"
cam = "igc1.50"

# Single shared lyrics library, global (not per-profile) — see
# docs/lyrics-library-design.md. local_dir is persistent, user-editable
# content (survives cache clears) — point it at wherever your library lives,
# NAS-backed or local. genius_token stays blank here; it's inert today (see
# the design doc) and, like the other credentials above, only ever lands in
# your local (gitignored) site.toml, never committed.
[media.lyrics]
local_dir = "YOUR_LYRICS_LIBRARY_PATH"
enable_local = true
enable_online = true
providers_noapi = ["lrclib", "lyrics_ovh"]
providers_api = ["genius"]
genius_token = ""
strip_lrc_timestamps = true
