suite_id = "osa"
name = "gtex62-osa"
suite_repo = "__SUITE_REPO__"
suite_manifest = "__SUITE_REPO__/suite.toml"
enabled = true

[profiles]
weather = "home"
air = "home"
aviation = "home"
astro = "home"
calendar = "local"
network = "local"
connectivity = "default"
pfsense = "main_router"
solar = "home"
media = "local"
# AirGradient indoor air quality is OFF by default (it needs an AirGradient ONE on your network).
# To turn it on, uncomment the next line AND add "airgradient" to [domains] optional below, set
# [providers] airgradient = true in core.toml, and put the device address in
# profiles/airgradient/indoor.toml. Without the binding OSA never looks for the data.
# airgradient = "indoor"

[domains]
required = [
  "system",
  "time",
  "calendar",
  "astro",
  "weather",
  "aviation",
  "air",
  "solar",
  "network",
  "connectivity",
  "pfsense",
]
optional = [
  "pollen",
]

[suite_cache]
namespaces = ["sys", "tme", "orb", "wxr", "net", "env"]
