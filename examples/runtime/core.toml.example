core_id = "gtex62-core"
version = "0.6.4"

[paths]
config_root = "__RUNTIME_ROOT__"
data_root = "__HOME__/.local/share/gtex62-core"
cache_root = "__HOME__/.cache/gtex62-core"
suites_root = "__HOME__/.config/conky"

[registry]
suites_dir = "suites"
profiles_dir = "profiles"
overrides_dir = "overrides"
state_dir = "state"

[doctor]
enabled = true

[launcher]
default_suite = "osa"
allow_legacy_suites = true

[providers]
# vpn/ap/modem/alerts are wired into gtex62-core-launch (see
# bin/gtex62-core-launch, "Provider enable/disable" comment) — true starts
# that domain's fetch script running via initial_refresh/refresh_loop.
# alerts (providers/alerts/fetch_alerts.sh) reads other providers' already-
# written cache files, no SSH/gate of its own — same wiring shape as the
# rest, just nothing to skip on an ssh_gate trip. Defaults here stay false
# for a fresh install; flip per-suite in the live core.toml once you want a
# given domain running.
vpn = false
ap = false
modem = false
alerts = false
# Lyrics library provider (providers/media/fetch_lyrics.sh) — see
# docs/lyrics-library-design.md. Config is global (site.toml
# [media.lyrics]), not a profile TOML — same wiring shape as the flags
# above otherwise.
media = false

# All four flags below are wired into gtex62-core-launch (see
# bin/gtex62-core-launch, "Provider enable/disable" comment) — true starts
# that domain's fetch script running. router/pihole/pfblockerng reuse the
# pfsense profile (profiles/pfsense/{profile}.toml) for TTL/target
# resolution, same as status. Defaults here stay false for a fresh install;
# flip per-suite in the live core.toml once you want a given domain running.
[providers.pfsense]
status = false
router = false
# Note: Pi-hole runs on Pi5, not pfSense itself — nested here to match
# fetch_pfsense.sh's existing four-output structure, not because it's
# hosted on the pfSense box.
pihole = false
pfblockerng = false
# Fast (~1s) interface byte-counter poller (fetch_pfsense_ifaces.sh) — own
# cache file (ifaces.json), own gate (runtime/pfsense_ifaces), own TTL
# (ifaces_cache_ttl_sec). Independent of `status` above.
ifaces = false

# Alert-banner watcher thresholds/durations (providers/alerts/fetch_alerts.sh).
# See gtex62-sitrep/design/sitrep-design-notes.md § Alert banner / outage
# detection for the full condition table. MSMTCH and unidentified-IP have no
# threshold key here — any count > 0 is an alert, not configurable.
[alerts]
# gateway.online (status.json) continuously false for this long -> SEVERE
# "COMCAST OUTAGE DETECTED". Proxy for a true loss-% threshold — status.json
# only has a boolean today (single ping), not loss%/latency sampling; that
# is a separate, not-yet-built network-health provider (see
# docs/network-providers-roadmap.md).
gateway_offline_duration_sec = 900
# pihole.json active=false continuously for this long -> CAUTION
# "PI-HOLE INACTIVE". Duration-gated, not instantaneous — Pi-hole has been
# observed to blip inactive then self-recover.
pihole_inactive_duration_sec = 600
# vpn.json killswitch_mode=="on" (PIA Advanced Kill Switch) AND
# connectionstate != "Connected" continuously for this long -> SEVERE
# "KS BLOCKING TRAFFIC". Short debounce, not
# gateway-offline's 15min — this surfaces promptly rather than waiting out
# a blip, since the person may not remember Advanced mode is even on.
advanced_killswitch_duration_sec = 10
# T3 burst detection -- half of the CAUTION "COMCAST DEGRADED" OR-condition
# (see the two loss_pct keys below for the other half). Replaced 2026-09-10
# a flat `recent_t3_timeouts >= comcast_degraded_t3_threshold` (was 5): that
# field is a whole collapsed row's *lifetime* count, not "how many just
# happened," so once it crossed 5 it tended to stay crossed for as long as
# the same condition kept recurring at all, however mildly -- observed live,
# a trickle averaging ~2.5/hr stayed continuously breached for 40+ hours.
# These two instead gate on a genuine recent delta -- how many NEW
# occurrences landed within roughly this many minutes -- converted
# internally to a rate (events/hour) so an irregular real polling gap
# doesn't distort it. Defaults (5 within 5min = 60/hr) keep the same real-
# episode reference the old flat threshold used (docs/network-providers-
# roadmap.md's Aug 31/Sept 6-7 sessions: confirmed live T3 counts of 9,
# then 12 and climbing, during genuine Comcast episodes, vs. 0 on a quiet
# night) -- but IMPORTANT if retuning: at a normal ~5min poll cadence, one
# single isolated trickle hit computes to ~12/hr from measurement
# granularity alone, so the effective rate (count / (window_min/60)) needs
# to sit clearly above that floor or every trickle occurrence reads as a
# burst. See docs/network-providers-roadmap.md's Sept 8-10 session logs
# for the full investigation.
comcast_degraded_t3_burst_count = 5
comcast_degraded_t3_burst_window_min = 5
# pfsense/status.json's gateway.loss_pct (dpinger's own rolling 60s
# average, not a single ping) >= this percent, sustained for >=
# comcast_degraded_loss_duration_sec below -> the other half of the
# CAUTION "COMCAST DEGRADED" OR-condition. 25% matches the original design
# notes' aspirational ">=25% loss" target, now real since c7c3f37
# (2026-08-23) added live dpinger loss%/latency to status.json.
comcast_degraded_loss_pct_threshold = 25
# Duration-sustain for the loss_pct threshold above, same shape as
# gateway_offline_duration_sec but deliberately much shorter (5min, not
# 15min) — COMCAST DEGRADED is meant as an earlier warning, not a
# duplicate of the SEVERE full-outage condition on a longer fuse.
comcast_degraded_loss_duration_sec = 300
# How stale modem/status.json can get (file mtime vs. now) before the T3
# half of the OR-condition above is force-expired instead of re-asserting a
# frozen burst-active flag forever. Guards against fetch_modem.py stopping
# entirely (crash, dead loop, expired credential) rather than writing a
# fresh error state — that leaves the file saying "ok" with whatever it
# last saw, which nothing else would catch. 900s (15min) is 3x the modem
# provider's own 300s cache_ttl_sec — enough slack for a couple of missed
# polls, tight enough to not pin the banner for hours on a genuinely dead
# provider. See docs/network-providers-roadmap.md's Sept 8/9 session log.
comcast_degraded_t3_stale_sec = 900
